{
  "name": "livance-exact-ui-supabase-live",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "check": "node tests/static-check.mjs && node tests/live-bridge-check.mjs && node --check server/index.js && node --check server/live.js && node --check api/index.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.3",
    "vite": "^6.1.0"
  },
  "devDependencies": {},
  "version": "2.0.0"
}
