{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {"source": "/api/:path*", "destination": "/api/index.js?__route=:path*"},
    {"source": "/admin", "destination": "/index.html"},
    {"source": "/admin/:path*", "destination": "/index.html"}
  ]
}
