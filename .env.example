# 1) Supabase > Project Settings > Data API / API Keys
# Project URL. Never paste the database password here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# 2) Verified email sending provider (Resend) — server ONLY, never VITE_
RESEND_API_KEY=
# Must be a verified sending domain/address in your Resend account.
EMAIL_FROM=Livance <notifications@YOUR_VERIFIED_DOMAIN>
# Receives new lead and booking notifications.
NOTIFY_EMAIL=hello@YOUR_VERIFIED_DOMAIN

# 3) Local server and production site
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173

# Optional: enabling third-party services later requires their own secure integrations.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
